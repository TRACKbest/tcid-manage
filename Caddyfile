{$VPS_DOMAIN}, www.{$VPS_DOMAIN} {
    encode zstd gzip

    # Virtual classroom: Jitsi Meet served as the "meet" tenant
    # (https://<domain>/meet/<room>, /meet/http-bind, /meet/xmpp-websocket).
    # Read-only Jitsi health (jicofo test conference on a videobridge).
    handle /meet/_health {
        rewrite * /about/health
        reverse_proxy jitsi-jicofo:8888
    }

    handle /meet/* {
        reverse_proxy jitsi-web:8000
    }

    handle {
        reverse_proxy frontend:8080
    }
}

:80 {
    reverse_proxy frontend:8080
}
